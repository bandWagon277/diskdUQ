# Low-dimensional well-specified control for sampler/posterior diagnostics.
SCRIPT=experiments/scripts/manuscript/linear_wellspec_probe.py
DEVICE=cpu
TORCH_THREADS=4
OUT_DIR=outputs/07_wellspecified_linear

SPEC=well
NUM_DURATIONS=12
N=500
SEEDS=42,43
ETA=1.0
OMEGA=1.0
TEACHER=oracle
TEST_N=1000
FIXED_TEST_SEED=2026
MALA_ITERS=2000
BURNIN=500
THIN=5
STEP=5e-4
PRIOR_SIGMA=10.0
