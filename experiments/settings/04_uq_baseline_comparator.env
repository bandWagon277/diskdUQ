# Study B/C: comparator table. Non-Bayesian UQ engines are baselines only.
# The scalar true-CIF calibration in this script is oracle/simulation-only.
SCRIPT=experiments/scripts/uq_baselines/uq_engine_comparator_probe.py
DEVICE=cpu
TORCH_THREADS=4
OUT_DIR=outputs/04_uq_baseline_comparator

TEACHER_N=5000
STUDENT_N=500
TEST_N=500
TEACHER_FEATURE_QUALITY=full
CALIB_FRACTION=0.2
SEEDS=42,43
ENGINES=deep,bootstrap,mc_dropout,sgld

TEACHER_EPOCHS=80
ADAMW_EPOCHS=40
BATCH_SIZE=64
ENSEMBLE_SIZE=5
MC_DROPOUT_SAMPLES=200
DROPOUT=0.1

SGLD_EPOCHS=200
BURNIN_EPOCHS=0
N_CHAINS=3
SAMPLES_PER_CHAIN=200
EPS0=2e-4
EPS_T=2e-4
GAMMA=0.55
NOISE_SCALE=1.0
TARGET_COVERAGE=0.95
WIDEN_ONLY=1

