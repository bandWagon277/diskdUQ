# Generalized-posterior omega sweep for full-network and last-layer SGLD.
SCRIPT=experiments/scripts/sgld_diagnostics/sgld_omega_sweep_full_vs_lastlayer.py
DEVICE=cpu
TORCH_THREADS=4
OUT_DIR=outputs/06_sgld_omega_full_lastlayer

TEACHER_N=5000
STUDENT_N=500
TEST_N=500
TEACHER_FEATURE_QUALITY=full
CALIB_FRACTION=0.2
SEEDS=42,43
OMEGAS=0.25,0.5,1.0,2.0
TARGETS=full,last_layer
TARGET_COVERAGE=0.95

TEACHER_EPOCHS=80
ADAMW_EPOCHS=40
BATCH_SIZE=64
STUDENT_HIDDEN=32

SGLD_EPOCHS=200
BURNIN_EPOCHS=0
N_CHAINS=3
SAMPLES_PER_CHAIN=200
EPS0=2e-4
EPS_T=2e-4
GAMMA=0.55
NOISE_SCALE=1.0

